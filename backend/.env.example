# Multi API Key Pool configuration (prevents 429 rate-limit exhaustion)
GROQ_API_KEY=gsk_key1...
GROQ_API_KEY_2=gsk_key2...
GROQ_API_KEY_3=gsk_key3...
# Or provide comma-separated keys:
# GROQ_API_KEYS=gsk_key1...,gsk_key2...,gsk_key3...

DATABASE_PATH=./agent.db
MIN_CYCLE_MINUTES=90
MAX_CYCLE_MINUTES=240
PORT=3000
DEV_FAST_CYCLE=false

# Supabase Cloud Database Configuration
SUPABASE_URL=https://kencqsilslmwvbgubmjl.supabase.co
SUPABASE_KEY=your_supabase_publishable_key_here

